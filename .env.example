# ==============================================================================
# Candlemaster Academy - AI Teacher Bot Environment Configuration
# ==============================================================================

# 1. Telegram Bot Token (Get from @BotFather on Telegram)
BOT_TOKEN=your_telegram_bot_token_here

# 2. Channels and Group IDs / Usernames
# Channel 1: Lessons Channel (Only bot posts lessons)
LESSONS_CHANNEL_ID=-100xxxxxxxxxx

# Channel 2: Assignments Channel (Only bot posts assignments and corrections)
ASSIGNMENTS_CHANNEL_ID=-100xxxxxxxxxx

# Group: Discussion Group (Students ask questions here)
# Use the @username or negative integer ID (e.g. -1001234567890)
DISCUSSION_GROUP_ID=-100xxxxxxxxxx

# 3. Admin Telegram User IDs (Comma-separated)
# You can find your personal Telegram ID by messaging @userinfobot
ADMIN_IDS=123456789

# 4. AI Engine API Keys (Optional - Bot works 100% with built-in knowledge base if left empty!)
# Get free Gemini API key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Or OpenAI API key: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# 5. Database Path
DB_PATH=forex_teacher.db

# 6. Timezone (Ghana is GMT / UTC+0 year-round)
TIMEZONE=Africa/Accra

# 7. Active Curriculum Day (1-14)
CURRENT_DAY=1


